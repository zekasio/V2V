# ============================================================
# V2V - Video Localization Pipeline Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- Murf Dub API ---
MURFDUB_API_KEY=your_murfdub_api_key_here

# --- LLM Translation (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Pipeline Settings ---
# Source language code (ISO 639-1)
SOURCE_LANGUAGE=tr
# Target locale for Murf dubbing
TARGET_LOCALE=en_US
# Target language name for translation prompts
TARGET_LANGUAGE=English

# --- OCR Settings ---
# Minimum confidence for OCR text detection (0.0 - 1.0)
OCR_CONFIDENCE_THRESHOLD=0.65
# Maximum frames to sample per second for OCR
OCR_SAMPLE_FPS=2
# Enable scene-based keyframe extraction (true/false)
OCR_USE_SCENE_DETECTION=true

# --- Inpainting ---
# Primary: lama | Fallback: telea, ns (Navier-Stokes)
INPAINTING_METHOD=lama
# Mask dilation pixels for inpainting
INPAINTING_MASK_DILATION=15

# --- Subtitle Settings ---
# Mode: external | burned
SUBTITLE_MODE=external
# Font for burned subtitles
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=24

# --- Video Output ---
# FFmpeg CRF quality (lower = better, 18-28 recommended)
OUTPUT_VIDEO_CRF=20
# Output video codec
OUTPUT_VIDEO_CODEC=libx264
# Output audio codec
OUTPUT_AUDIO_CODEC=aac

# --- Directories ---
INPUT_DIR=input
OUTPUT_DIR=output
TEMP_DIR=temp
LOG_DIR=logs

# --- Logging ---
LOG_LEVEL=INFO
